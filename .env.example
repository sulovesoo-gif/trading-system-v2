KIS_TOKEN_CACHE_PATH=.cache/kis_token.json

# Docker Compose test database variables. These configure the container only.
TIMESCALEDB_PORT=5432
TIMESCALEDB_DB=trading_system_v2_test
TIMESCALEDB_USER=trading_test
TIMESCALEDB_PASSWORD=

# Application integration-test variables. Set these explicitly for the target test DB.
# DB_PORT should normally match TIMESCALEDB_PORT, but the names are intentionally separate.
DB_INTEGRATION_TEST=0
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_system_v2_test
DB_USER=trading_test
DB_PASSWORD=
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# SMA 크로스 이메일 알림. 실제 값은 .env에만 설정하며 Git에 저장하지 않습니다.
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_STARTTLS=Y
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
