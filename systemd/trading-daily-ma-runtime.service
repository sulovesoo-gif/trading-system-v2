[Unit]
Description=Trading V2 Daily MA runtime (actual-send fail-closed)
After=network-online.target trading-execution-reconciliation.service
[Service]
Type=oneshot
RemainAfterExit=yes
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/trading-system-v2
EnvironmentFile=/home/ubuntu/projects/trading-system-v2/.env
Environment=DAILY_MA_ACTUAL_SEND=N
Environment=DAILY_MA_RUNTIME_TRANSPORT=REAL
ExecStart=/home/ubuntu/projects/trading-system-v2/venv/bin/python scripts/runtime/run_daily_ma_actual_submit.py
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
