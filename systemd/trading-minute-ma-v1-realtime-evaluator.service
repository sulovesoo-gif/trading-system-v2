[Unit]
Description=Trading V2 Minute MA V1 realtime finalized-bar evaluator
After=network-online.target trading-minute-realtime-1min-builder.service trading-execution-reconciliation.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/trading-system-v2
EnvironmentFile=/home/ubuntu/projects/trading-system-v2/.env
Environment=PYTHONPATH=/home/ubuntu/projects/trading-system-v2
Environment=MINUTE_MA_V1_PAPER_WRITE=Y
ExecStart=/home/ubuntu/projects/trading-system-v2/venv/bin/python scripts/runtime/run_minute_ma_v1_realtime_dispatcher.py
Restart=always
RestartSec=2
TimeoutStopSec=20
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
