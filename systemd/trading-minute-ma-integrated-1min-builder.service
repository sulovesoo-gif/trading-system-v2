[Unit]
Description=Trading V2 Minute MA INTEGRATED realtime 1MIN builder
After=network-online.target trading-system-v2-timescaledb-test.service trading-minute-ma-integrated-collector.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/trading-system-v2
EnvironmentFile=/home/ubuntu/projects/trading-system-v2/.env
Environment=PYTHONPATH=/home/ubuntu/projects/trading-system-v2
Environment=MINUTE_MA_INTEGRATED_FINALIZE_GRACE_MS=2000
Environment=MINUTE_MA_INTEGRATED_POLL_MS=250
ExecStart=/home/ubuntu/projects/trading-system-v2/venv/bin/python scripts/runtime/run_minute_ma_integrated_1min_builder.py
Restart=always
RestartSec=2
TimeoutStopSec=20
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
