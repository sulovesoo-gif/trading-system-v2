[Unit]
Description=Trading System V2 Minute MA REAL PAPER dashboard
After=network-online.target

[Service]
WorkingDirectory=/home/ubuntu/projects/trading-system-v2
EnvironmentFile=/home/ubuntu/projects/trading-system-v2/.env
ExecStart=/home/ubuntu/projects/trading-system-v2/venv/bin/python scripts/dashboard/serve_minute_ma_real_dashboard.py
Restart=on-failure

[Install]
WantedBy=multi-user.target
