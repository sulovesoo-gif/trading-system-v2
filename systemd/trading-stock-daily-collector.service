[Unit]
Description=Trading V2 official Daily RAW collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/trading-system-v2
EnvironmentFile=/home/ubuntu/projects/trading-system-v2/.env
ExecStart=/home/ubuntu/projects/trading-system-v2/venv/bin/python scripts/realtime/run_stock_daily_collector.py
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
