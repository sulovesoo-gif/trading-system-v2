[Unit]
Description=Trading V2 Minute MA V1.0 PAPER runtime (disabled by default)
After=network-online.target trading-forward-raw-collector.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/trading-system-v2
EnvironmentFile=/home/ubuntu/projects/trading-system-v2/.env
Environment=MINUTE_MA_V1_PAPER_WRITE=Y
ExecStart=/home/ubuntu/projects/trading-system-v2/venv/bin/python scripts/runtime/run_minute_ma_v1_paper.py --date-current --write
NoNewPrivileges=true
