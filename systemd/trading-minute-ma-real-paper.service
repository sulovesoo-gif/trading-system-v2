[Unit]
Description=Trading System V2 Minute MA REAL PAPER incremental evaluator
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/projects/trading-system-v2
EnvironmentFile=/home/ubuntu/projects/trading-system-v2/.env
ExecStart=/home/ubuntu/projects/trading-system-v2/venv/bin/python scripts/runtime/run_minute_ma_real_paper.py incremental
Nice=10
