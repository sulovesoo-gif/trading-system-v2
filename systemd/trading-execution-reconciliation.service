[Unit]
Description=Trading V2 read-only broker position reconciliation
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/trading-system-v2
EnvironmentFile=/home/ubuntu/projects/trading-system-v2/.env
Environment=PYTHONPATH=/home/ubuntu/projects/trading-system-v2
ExecStart=/home/ubuntu/projects/trading-system-v2/venv/bin/python scripts/runtime/run_execution_reconciliation.py --interval-seconds 300
Restart=always
RestartSec=15
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
