[Unit]
Description=Independent READ ONLY FLOW Leadership Dashboard
After=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/trading-system-v2
EnvironmentFile=/etc/trading-flow-leadership-readonly.env
ExecStart=/home/ubuntu/projects/trading-system-v2/venv/bin/python scripts/dashboard/serve_flow_v3_leadership.py --bind 127.0.0.1 --port 8094
Restart=on-failure
RestartSec=10
Nice=10
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Loopback only. Production ingress/authentication requires separate deployment approval.

[Install]
WantedBy=multi-user.target
