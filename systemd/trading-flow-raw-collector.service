[Unit]
Description=Trading V2 KIS FLOW RAW websocket collector (005930, 000660)
After=network-online.target trading-system-v2-timescaledb-test.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/trading-system-v2
EnvironmentFile=/home/ubuntu/projects/trading-system-v2/.env
Environment=PYTHONPATH=/home/ubuntu/projects/trading-system-v2
ExecStart=/home/ubuntu/projects/trading-system-v2/venv/bin/python scripts/runtime/run_flow_raw_collector.py
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
