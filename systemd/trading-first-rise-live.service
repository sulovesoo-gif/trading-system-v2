[Unit]
Description=Trading System V2 FIRST_RISE J independent LIVE execution
After=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/trading-system-v2
EnvironmentFile=/home/ubuntu/projects/trading-system-v2/.env
ExecStart=/home/ubuntu/projects/trading-system-v2/venv/bin/python scripts/runtime/run_first_rise_live.py
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
