[Unit]
Description=Trading V2 four-axis minute MA PAPER and LIVE NO_SEND runtime
After=network-online.target trading-forward-raw-collector.service trading-execution-reconciliation.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/trading-system-v2
EnvironmentFile=/home/ubuntu/projects/trading-system-v2/.env
Environment=MINUTE_MA_PAPER_WRITE=Y
ExecStart=/home/ubuntu/projects/trading-system-v2/venv/bin/python scripts/runtime/run_minute_ma_paper.py --date-current --write
ExecStartPost=/home/ubuntu/projects/trading-system-v2/venv/bin/python scripts/runtime/run_minute_ma_live_nosend.py
NoNewPrivileges=true

