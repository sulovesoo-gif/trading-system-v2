[Unit]
Description=Trading System V2 read-only multi MA dashboard
After=network-online.target docker.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/projects/trading-system-v2
EnvironmentFile=/home/ubuntu/projects/trading-system-v2/.env
Environment=TZ=Asia/Seoul
ExecStartPre=/bin/bash -lc 'test "$DB_NAME" = "trading_system_v2_test"'
ExecStart=/home/ubuntu/projects/trading-system-v2/venv/bin/python scripts/dashboard/serve_multi_ma_dashboard.py --bind 0.0.0.0 --port 8090
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
