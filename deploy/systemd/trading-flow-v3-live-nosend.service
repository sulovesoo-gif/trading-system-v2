[Unit]
Description=FLOW V3 independent LIVE ledger worker (dual approval; default OFF)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/trading-system-v2
ExecStart=/home/ubuntu/projects/trading-system-v2/venv/bin/python scripts/runtime/run_flow_v3_live.py
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
Environment=PYTHONUNBUFFERED=1
Environment=FLOW_V3_ACTUAL_SEND=N
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
